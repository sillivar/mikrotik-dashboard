# ==============================================================================
# MikroTik Dashboard Environment Variables Config Template
# ==============================================================================

# Custom credentials for web dashboard login (default: admin / admin123)
APP_USER=admin
APP_PASSWORD=admin123

# Secret key used for signing session cookie JWTs. Set this to a strong random hex string.
# Example command to generate: openssl rand -hex 32
SESSION_SECRET_KEY=some-super-random-secret-session-key-change-me

# Encryption key for securing router credentials in SQLite database.
# For maximum security, use a valid 32-byte Fernet key.
# Example command to generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=some-secure-encryption-key-string-for-router-passwords
